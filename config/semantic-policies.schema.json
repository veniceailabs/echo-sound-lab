{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Policies Configuration Schema",
  "description": "JSON Schema for validating semantic policy configuration files used by Level 4: Contextual Reasoning",
  "type": "object",
  "required": ["version", "coreRules"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration format version (semantic versioning)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": ["1.0.0"]
    },
    "coreRules": {
      "type": "object",
      "description": "Enable/disable core safety policies",
      "required": ["piiDetection", "externalApiDetection", "productionDataProtection"],
      "properties": {
        "piiDetection": {
          "type": "boolean",
          "description": "Detect PII exposure (emails, SSNs, phone numbers, credit cards)"
        },
        "externalApiDetection": {
          "type": "boolean",
          "description": "Detect external API calls (HTTP URLs, fetch/axios, WebSocket)"
        },
        "productionDataProtection": {
          "type": "boolean",
          "description": "Detect destructive operations on production databases"
        }
      },
      "additionalProperties": false
    },
    "customRules": {
      "type": "array",
      "description": "User-defined policy rules",
      "items": {
        "type": "object",
        "required": ["id", "name", "checkFields", "pattern", "violationType", "severity", "reason", "suggestedFix", "enabled"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this rule",
            "pattern": "^[a-z0-9\\-_.]+$",
            "minLength": 3,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "description": "Display name for this rule",
            "minLength": 1,
            "maxLength": 200
          },
          "checkFields": {
            "type": "array",
            "description": "Fields to check for pattern matches",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["parameters", "codeContext", "dataContext", "proposalId", "actionType"]
            }
          },
          "pattern": {
            "type": "string",
            "description": "Regular expression pattern to match against",
            "minLength": 1,
            "maxLength": 500
          },
          "violationType": {
            "type": "string",
            "description": "Type of violation this rule detects",
            "enum": ["PII_EXPOSURE", "EXTERNAL_API_CALL", "PRODUCTION_DATA_MODIFICATION", "CUSTOM_RULE"]
          },
          "severity": {
            "type": "string",
            "description": "Severity level (CRITICAL/HIGH block execution)",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "reason": {
            "type": "string",
            "description": "Human-readable description of what this rule detects",
            "minLength": 1,
            "maxLength": 500
          },
          "suggestedFix": {
            "type": "string",
            "description": "Suggested action to fix violations of this rule",
            "minLength": 1,
            "maxLength": 500
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this rule is active"
          }
        },
        "additionalProperties": false
      }
    },
    "exemptions": {
      "type": "object",
      "description": "Exemptions for specific action types or violation types",
      "patternProperties": {
        "^(actionType|violationType):[a-zA-Z0-9_]+$": {
          "type": "array",
          "description": "Violation types to exempt for this action/category",
          "items": {
            "type": "string",
            "enum": ["PII_EXPOSURE", "EXTERNAL_API_CALL", "PRODUCTION_DATA_MODIFICATION", "CUSTOM_RULE"]
          }
        }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "description": "Performance and security tuning",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "description": "Maximum milliseconds to spend evaluating policies",
          "minimum": 10,
          "maximum": 1000,
          "default": 50
        },
        "maxPatternComplexity": {
          "type": "integer",
          "description": "Maximum regex pattern complexity (prevents ReDoS attacks)",
          "minimum": 10,
          "maximum": 500,
          "default": 50
        },
        "cacheMaxSize": {
          "type": "integer",
          "description": "Maximum number of policy results to cache (LRU)",
          "minimum": 0,
          "maximum": 10000,
          "default": 100
        }
      },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "description": "Logging configuration for policy evaluations",
      "properties": {
        "logEvaluations": {
          "type": "boolean",
          "description": "Log all policy evaluations (verbose)",
          "default": true
        },
        "logViolationsOnly": {
          "type": "boolean",
          "description": "Only log violations (overrides logEvaluations)",
          "default": false
        },
        "logErrors": {
          "type": "boolean",
          "description": "Log evaluation errors (timeout, regex failures)",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
