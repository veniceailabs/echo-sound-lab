{
  "name": "Echo Sound Lab",
  "description": "Professional Audio Mastering Engine - Phase 3-6 Pipeline",
  "keywords": ["audio", "mastering", "ai", "music-production"],
  "env": {
    "PYTHON_VERSION": {
      "description": "Python version to use",
      "value": "3.11.7"
    },
    "PORT": {
      "description": "Port to run the server on",
      "value": "8000"
    }
  },
  "buildCommand": "pip install -r backend/requirements.txt",
  "startCommand": "cd backend && gunicorn -w 4 -b 0.0.0.0:$PORT --timeout 120 mastering_api:app",
  "deploy": {
    "builder": "nixpacks",
    "startCommand": "cd backend && gunicorn -w 4 -b 0.0.0.0:$PORT --timeout 120 mastering_api:app"
  }
}
