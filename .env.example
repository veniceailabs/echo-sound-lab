# Echo Sound Lab — Complete Production Configuration
# Copy this to .env.local and fill in your actual values

# ============================================================================
# FRONTEND - Vite Environment Variables
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PRICE_ARTIST=price_...
VITE_STRIPE_PRICE_ENGINEER=price_...
VITE_STRIPE_PRICE_STUDIO=price_...
VITE_COLLAB_WS_SERVER=wss://collab.your-domain.com

# ============================================================================
# BACKEND - Stripe Payments
# ============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ARTIST=price_...
STRIPE_PRICE_ENGINEER=price_...
STRIPE_PRICE_STUDIO=price_...

# ============================================================================
# BACKEND - DistroKid Distribution
# ============================================================================
DISTROKID_CLIENT_ID=...
DISTROKID_CLIENT_SECRET=...
DISTROKID_API_KEY=...

# ============================================================================
# BACKEND - Database (Supabase PostgreSQL)
# ============================================================================
DATABASE_URL=postgres://user:password@host/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ============================================================================
# BACKEND - Authentication
# ============================================================================
NEXTAUTH_SECRET=your-random-secret-key-min-32-chars
NEXTAUTH_URL=https://echo-sound-lab.vercel.app

# ============================================================================
# BACKEND - Storage (S3 or Supabase Storage)
# ============================================================================
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=echo-sound-lab-audio

# ============================================================================
# BACKEND - Collaboration Server (WebSocket)
# ============================================================================
COLLAB_WS_SERVER=ws://localhost:3001
REDIS_URL=redis://:password@host:port

# ============================================================================
# BACKEND - Email Service
# ============================================================================
RESEND_API_KEY=...
SENDGRID_API_KEY=...
MAIL_FROM=noreply@echo-sound-lab.com

# ============================================================================
# GEMINI API (existing)
# ============================================================================
GEMINI_API_KEY=your_api_key_here
ESL_MANIFEST_SIGNING_KEY=replace_with_a_long_random_secret

# ============================================================================
# INTEGRATIONS (existing)
# ============================================================================
ENABLE_SUNO_INTEGRATION=false
ENABLE_PREMIUM_VOICE=false
ENABLE_ANIMATE_ART=false

VITE_ENABLE_SUNO_INTEGRATION=false
VITE_ENABLE_PREMIUM_VOICE=false
VITE_ENABLE_ANIMATE_ART=false

# ============================================================================
# MONITORING & ANALYTICS (optional)
# ============================================================================
POSTHOG_API_KEY=...
SENTRY_DSN=...
VERCEL_ENV=production
